# Токен Discord-бота из Discord Developer Portal (вкладка Bot -> Reset Token).
# ВАЖНО: никому не передавайте этот токен и никогда не публикуйте файл .env!
DISCORD_TOKEN=your_discord_bot_token_here

# ID вашего Discord-сервера (гильдии) для мгновенной синхронизации slash-команд.
# Рекомендуется обязательно заполнить. Если оставить пустым, будет выполнена
# глобальная синхронизация (появление команды в Discord может занять до 1 часа).
GUILD_ID=123456789012345678

# ID специального текстового канала, в котором разрешено вызывать /anonim_message.
ANON_CHANNEL_ID=123456789012345679

# ID общего текстового канала, куда бот отправляет анонимные сообщения.
PUBLIC_CHANNEL_ID=123456789012345680

# Уровень логирования в терминал: DEBUG, INFO, WARNING, ERROR, CRITICAL (по умолчанию INFO).
LOG_LEVEL=INFO

# Необязательный прокси для подключения к Discord API и Gateway (актуально при блокировке Discord).
# Если оставить пустым — бот автоматически использует системный прокси ОС (если он включён),
# либо подключается напрямую. Чтобы принудительно отключить системный прокси, укажите PROXY_URL=direct
# Примеры:
#   PROXY_URL=http://127.0.0.1:2080
#   PROXY_URL=socks5://127.0.0.1:10808
#   PROXY_URL=http://user:password@1.2.3.4:3128
PROXY_URL=
